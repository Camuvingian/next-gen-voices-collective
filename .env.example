# Copy to .env.local for `next dev`; set the same in Vercel → Settings → Environment Variables.

# Email (resend.com)
RESEND_API_KEY=re_xxxxxxxx
# the sender: any address on the domain verified in Resend (nextgenvoices.live)
EMAIL_FROM="NextGen Voice Collective <applications@nextgenvoices.live>"
# where applications and enquiries go (both default to bradley@bradleyvocalcoach.com)
AUDITIONS_TO=bradley@bradleyvocalcoach.com
CONTACT_TO=bradley@bradleyvocalcoach.com
# the public site address, for links and the header image in emails
SITE_URL=https://www.nextgenvoices.live

# Audition video uploads: a private Vercel Blob store (Storage → Blob), connected to the project.
# Vercel adds these when the store is connected, and logs in with its own OIDC token at runtime.
# Locally, `vercel env pull .env.local` brings them (and a VERCEL_OIDC_TOKEN valid for 12 hours).
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=
# (a classic store's read-write token also works instead)
# BLOB_READ_WRITE_TOKEN=
# Optional: signs the private video links in emails (defaults to CRON_SECRET)
VIDEO_LINK_SECRET=

# Vercel Cron sends this to /api/cron/purge-videos (videos are kept 14 days at most)
CRON_SECRET=
